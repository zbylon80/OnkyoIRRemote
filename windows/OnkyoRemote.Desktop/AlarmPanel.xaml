<UserControl x:Class="OnkyoRemote.Desktop.AlarmPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="Button">
   <Setter Property="MinHeight" Value="36" /><Setter Property="Padding" Value="8,4" />
   <Setter Property="Margin" Value="0,3" /><Setter Property="Foreground" Value="#EEEAE2" />
   <Setter Property="Background" Value="#333333" /><Setter Property="BorderBrush" Value="#777777" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Face" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#EEEAE2" /></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#E9D7AB" /></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.5" /></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="5,3" />
   <Setter Property="Foreground" Value="#161616" /><Setter Property="Background" Value="#EEEAE2" />
   <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="Note" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#BBB5AA" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="4,4,4,8">
   <DockPanel><Button x:Name="BackButton" Content="← Pilot" DockPanel.Dock="Right" Click="Back_Click" Padding="8,2" MinHeight="28" />
    <TextBlock Text="Budzik" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
   <TextBlock x:Name="ClockText" Style="{StaticResource Note}" Margin="0,6,0,8" />
   <Border Background="#202020" BorderBrush="#8CAE86" BorderThickness="2,1,1,1" CornerRadius="6" Padding="10" Margin="0,4">
    <StackPanel>
     <TextBlock Text="☀ Włącz" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
     <DockPanel Margin="0,0,0,6"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
      <ComboBox x:Name="OnHour" Width="54" AutomationProperties.Name="Godzina włączenia" />
      <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
      <ComboBox x:Name="OnMinute" Width="54" AutomationProperties.Name="Minuty włączenia" />
     </StackPanel><TextBlock Text="Godzina" VerticalAlignment="Center" FontSize="12" /></DockPanel>
     <DockPanel Margin="0,0,0,6"><ComboBox x:Name="Source" Width="122" DockPanel.Dock="Right" AutomationProperties.Name="Źródło pobudki" />
      <TextBlock Text="Źródło" VerticalAlignment="Center" FontSize="12" /></DockPanel>
     <DockPanel><Button x:Name="OnCancel" Content="×" Tag="cancelOn" Width="32" DockPanel.Dock="Right" Margin="6,3,0,3" Click="Set_Click" Visibility="Collapsed" AutomationProperties.Name="Anuluj włączenie" ToolTip="Anuluj włączenie" />
      <Button x:Name="OnSet" Content="Ustaw" Tag="on" Background="#465D40" BorderBrush="#8CAE86" Click="Set_Click" /></DockPanel>
     <TextBlock x:Name="OnStatus" Style="{StaticResource Note}" Margin="0,5,0,0" />
    </StackPanel>
   </Border>
   <Border Background="#202020" BorderBrush="#9E8582" BorderThickness="2,1,1,1" CornerRadius="6" Padding="10" Margin="0,4">
    <StackPanel>
     <TextBlock Text="☾ Wyłącz" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
     <DockPanel Margin="0,0,0,6"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
      <ComboBox x:Name="OffHour" Width="54" AutomationProperties.Name="Godzina wyłączenia" />
      <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
      <ComboBox x:Name="OffMinute" Width="54" AutomationProperties.Name="Minuty wyłączenia" />
     </StackPanel><TextBlock Text="Godzina" VerticalAlignment="Center" FontSize="12" /></DockPanel>
     <DockPanel><Button x:Name="OffCancel" Content="×" Tag="cancelOff" Width="32" DockPanel.Dock="Right" Margin="6,3,0,3" Click="Set_Click" Visibility="Collapsed" AutomationProperties.Name="Anuluj wyłączenie" ToolTip="Anuluj wyłączenie" />
      <Button x:Name="OffSet" Content="Ustaw" Tag="off" Background="#554340" BorderBrush="#9E8582" Click="Set_Click" /></DockPanel>
     <TextBlock x:Name="OffStatus" Style="{StaticResource Note}" Margin="0,5,0,0" />
    </StackPanel>
   </Border>
   <TextBlock x:Name="ResultText" Style="{StaticResource Note}" Margin="0,6,0,2" AutomationProperties.LiveSetting="Polite" />
   <DockPanel Margin="0,4,0,0"><Button x:Name="RefreshButton" Content="Odśwież" DockPanel.Dock="Right" Click="Refresh_Click" MinHeight="30" />
    <TextBlock Text="Każda akcja wykona się raz." Style="{StaticResource Note}" VerticalAlignment="Center" /></DockPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
