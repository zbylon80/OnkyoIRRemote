<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#55201D" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#C27067" /></shape>
    </item>
    <item>
        <shape><gradient android:startColor="#9F3B35" android:endColor="#64231F" android:angle="315" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#C27067" /></shape>
    </item>
</selector>
