<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><solid android:color="#101010" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#D1C8BA" /></shape>
    </item>
    <item>
        <shape><gradient android:startColor="#3B3B3B" android:endColor="#1D1D1D" android:angle="315" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#666666" /></shape>
    </item>
</selector>
