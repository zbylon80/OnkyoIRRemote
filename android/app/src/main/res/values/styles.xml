<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D1C8BA</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#161616</item>
    </style>
    <style name="WidgetKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/key_background</item>
        <item name="android:textColor">#EEEAE2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">2dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:gravity">bottom</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textColor">#C8C1B6</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
</resources>
